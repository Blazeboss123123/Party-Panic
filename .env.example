# Copy the values you need into your host's environment settings (the server reads real
# environment variables; it does not load this file by itself).

# Port and interface to listen on. Hosts like Render set PORT for you.
PORT=3000
HOST=0.0.0.0

# Seconds a disconnected player keeps their seat before being removed.
PP_RECONNECT_GRACE=60
# Seconds an empty room is kept before it is deleted.
PP_EMPTY_ROOM_TTL=120
# Maximum number of rooms at once.
PP_MAX_ROOMS=500
# Logging: info (default) or silent.
PP_LOG=info

# Testing only — leave unset in production.
# PP_FAST=1                 shorter phases and countdowns
# PP_PHASE_SCALE=0.5        multiply every between-round phase length
# PP_DURATION_SCALE=0.5     multiply every minigame time limit
# PP_FORCE_GAMES=bomb-relay,colour-rush   always offer these games first in voting
